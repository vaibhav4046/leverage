{
  "name": "leverage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "mission": "tsx scripts/run-mission.ts",
    "probe:models": "tsx scripts/benchmark-models.ts",
    "verify:rocketride": "tsx scripts/verify-rocketride.ts",
    "mcp": "node mcp/server.ts",
    "fixture:reset": "node -e \"require('fs').readdirSync('benchmark/forge-app/src').forEach(f=>require('fs').unlinkSync('benchmark/forge-app/src/'+f))\"",
    "fixture:reset:arcade": "node -e \"const fs=require('fs'),d='benchmark/arcade/src';fs.existsSync(d)&&fs.readdirSync(d).forEach(f=>fs.unlinkSync(d+'/'+f))\"",
    "fixture:reset:greeter": "node -e \"const fs=require('fs'),d='benchmark/greeter/src';fs.existsSync(d)&&fs.readdirSync(d).forEach(f=>fs.unlinkSync(d+'/'+f))\"",
    "arcade:publish": "node -e \"const fs=require('fs');fs.mkdirSync('public/arcade/src',{recursive:true});fs.copyFileSync('benchmark/arcade/index.html','public/arcade/index.html');fs.readdirSync('benchmark/arcade/src').forEach(f=>fs.copyFileSync('benchmark/arcade/src/'+f,'public/arcade/src/'+f))\"",
    "mission:arcade": "tsx scripts/run-mission.ts --arcade",
    "mcp:harness": "tsx scripts/mcp-harness.ts",
    "scale": "tsx scripts/scale-harness.ts",
    "pool:tunnel": "node scripts/pool-tunnel.mjs",
    "stack:up": "node scripts/stack-up.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.115.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rocketride": "^1.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
