# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Identity (Privy) ----
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=

# ---- Persistence (Supabase) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---- Execution fabric (RocketRide) ----
ROCKETRIDE_APIKEY=
ROCKETRIDE_URI=https://staging.rocketride.ai

# ---- Compute pool ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
OMNIROUTE_API_KEY=

# ---- Crypto ----
ENCRYPTION_MASTER_KEY=

# ---- Dev only ----
LEVERAGE_DEV_AUTH=0

# The public pool endpoint RocketRide's cloud workers call.
# A quick tunnel (the default fallback) is rate limited and its hostname changes
# on every start, so set these two for anything that has to stay up.
CLOUDFLARE_TUNNEL_TOKEN=
POOL_PUBLIC_URL=
